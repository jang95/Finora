# VS Code(REST Client 확장) / Visual Studio / Rider에서 요청 옆 "Send Request"를 눌러 API를 바로 호출해 볼 수 있다.
@Finora.Api_HostAddress = http://localhost:5153

GET {{Finora.Api_HostAddress}}/api/health
Accept: application/json

###

# 회원가입. inviteCode에는 "dotnet run --project Finora.Api -- invite create"로 발급한 코드를 넣는다. (실제 코드는 커밋하지 않는다)
POST {{Finora.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "inviteCode": "XXXX-XXXX-XXXX",
  "email": "test@example.com",
  "password": "password1"
}

###

# 로그인. 성공하면 204 + Cookie(finora.auth). REST Client는 받은 Cookie를 이후 요청에 자동으로 보낸다.
POST {{Finora.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "password1",
  "rememberMe": true
}

###

# 현재 사용자. 로그인 전이면 401
GET {{Finora.Api_HostAddress}}/api/me

###

# 로그아웃
POST {{Finora.Api_HostAddress}}/api/auth/logout

###
